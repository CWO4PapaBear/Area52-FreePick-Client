+-- BuildCreator's native filter boundary consumes numeric argument/sort IDs.
+-- Keep named keys in the widgets for labels, checked state and mutual exclusion.
+local function BuildCreatorNativeSelections(selected, sorting)
+    local ids = sorting and {
+        SORT_NONE=0, SORT_RATING_ASCENDING=1, SORT_RATING_DESCENDING=2,
+        SORT_DATE_ASCENDING=3, SORT_DATE_DESCENDING=4,
+    } or {
+        FILTER_FEATURED=1, FILTER_DIFFICULTY_RATING_EASY=2,
+        FILTER_DIFFICULTY_RATING_NORMAL=3, FILTER_DIFFICULTY_RATING_HARD=4,
+        FILTER_DIFFICULTY_RATING_VERY_HARD=5, FILTER_DIFFICULTY_RATING_IMPOSSIBLE=6,
+        FILTER_OWNED_BUILDS=7, FILTER_PRIMARY_STAT_STRENGTH=8,
+        FILTER_PRIMARY_STAT_AGILITY=9, FILTER_PRIMARY_STAT_INTELLECT=10,
+        FILTER_PRIMARY_STAT_SPIRIT=11, FILTER_ROLE_TANK=12,
+        FILTER_ROLE_HEALER=13, FILTER_ROLE_DAMAGE=14, FILTER_LAST_30_DAYS=15,
+    }
+    local aliases = {DEATH_KNIGHT="DEATHKNIGHT", KNIGHT_OF_XOROTH="FLESHWARDEN",
+        FILTER_CLASS_KNIGHT_OF_XOROTH="FLESHWARDEN", VENOMANCER="PROPHET",
+        PRIMALIST="WILDWALKER", SUN_CLERIC="SUNCLERIC"}
+    local converted = {}
+    for key, enabled in pairs(selected or {}) do
+        local id = type(key)=="number" and key or ids[key]
+        if not id and not sorting and type(key)=="string" then
+            local class = string.match(key, "^FILTER_CLASS_(.+)$")
+            local classID = class and Enum.Class[aliases[class] or class]
+            if classID and classID>=1 and classID<=32 then id=classID+15 end
+        end
+        if id and type(enabled)=="boolean" then converted[id]=enabled end
+    end
+    return converted
+end
